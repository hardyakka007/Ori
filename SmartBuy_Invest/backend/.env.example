PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smartbuy

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production

# Redis (for Bull queues)
